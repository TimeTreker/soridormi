UID=1000
GID=1000
CONTAINER_USER=chromie

# PC development runtime base.
RUNTIME_DEV_BASE=nvidia/cuda:13.1.2-cudnn-devel-ubuntu24.04

# Jetson AGX Orin runtime base. Adjust to match your installed JetPack/L4T.
ORIN_RUNTIME_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0

# Jetson AGX Thor runtime base. Adjust to match your installed JetPack/L4T/CUDA stack.
THOR_RUNTIME_BASE=nvidia/cuda:13.1.2-cudnn-devel-ubuntu24.04

# PC simulator base you already pulled.
SIM_BASE=nvidia/cuda:13.1.2-cudnn-devel-ubuntu24.04

SIM_HOST=127.0.0.1
SIM_PORT=5555
CONTROL_HZ=50

# PC runtime-dev GPU inference defaults.
SORIDORMI_ONNXRUNTIME_GPU=1
SORIDORMI_USE_CUDA_PROVIDER=1
