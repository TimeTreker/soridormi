UID=1000
GID=1000

# PC development runtime base.
RUNTIME_DEV_BASE=ubuntu:24.04

# Jetson AGX Orin runtime base. Adjust to match your installed JetPack/L4T.
ORIN_RUNTIME_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0

# Jetson AGX Thor runtime base. Adjust to match your installed JetPack/L4T/CUDA stack.
THOR_RUNTIME_BASE=nvidia/cuda:13.0.2-devel-ubuntu24.04

# PC simulator base you already pulled.
SIM_BASE=nvidia/cuda:12.8.1-devel-ubuntu24.04

SIM_HOST=127.0.0.1
SIM_PORT=5555
CONTROL_HZ=50
