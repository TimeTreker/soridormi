{
  "schema_version": "m8.scenario_curriculum.v1",
  "robot_profile": "open_duck_mini_v2",
  "purpose": "MuJoCo-first scenario curriculum for Soridormi skill execution, behavior validation, and context-conditioned teacher data collection.",
  "policy_context_contract": {
    "low_level_input": [
      "robot_state",
      "desired_command_or_desired_state",
      "task_context",
      "environment_context",
      "short_history"
    ],
    "low_level_output": "action_14d",
    "natural_language_allowed": false,
    "notes": "Chromie or another planner may translate language into structured skill/context fields, but the low-level policy receives bounded numeric/categorical context only."
  },
  "status_values": [
    "planned",
    "mujoco_registry_ready",
    "mujoco_eval_ready",
    "training_ready",
    "unsupported_current_robot"
  ],
  "defaults": {
    "backend": "mujoco",
    "profile": "open_duck_forward",
    "hardware_enabled": false,
    "control_hz_source": "runtime",
    "duration_limit_mode": "rollout_steps",
    "viewer_default": false
  },
  "scenario_families": [
    "locomotion_flat",
    "locomotion_turning",
    "locomotion_terrain",
    "obstacle_response",
    "recovery",
    "social_safe_body"
  ],
  "scenarios": [
