{
  "schema_version": 1,
  "robot": "open_duck_mini_v2",
  "milestone": "M7_skill_platform",
  "description": "Full Soridormi skill universe for Open Duck Mini v2. Skills are declared up front, but execution lands one-by-one through status and implementation phases. This manifest does not grant hardware execution.",
  "strategy": {
    "define_all_skills_first": true,
    "land_implementation_incrementally": true,
    "first_executable_subset_goal": "6_to_8_safe_sim_skills",
    "notes": "A skill may be declared even when unavailable. Status, actuator requirements, and phase determine whether it can be executed."
  },
  "status_vocab": [
    "available_sim",
    "available_sim_experimental",
    "planned",
    "planned_wrapper",
    "planned_external_target",
    "future",
    "future_pose_teacher",
    "future_residual_rl",
    "future_evaluation",
    "future_perception",
    "future_composite",
    "unsupported_current_robot"
  ],
  "execution_vocab": [
    "policy_velocity",
    "skill_wrapper",
    "scripted_keyframe",
    "scripted_tracking",
    "pose_transition",
    "trajectory_policy",
    "residual_policy",
    "future_policy",
    "future_hardware_extension",
    "composite"
  ],
  "defaults": {
    "sim_first": true,
    "hardware_enabled": false,
    "interruptible": true,
    "fallback": "stop_and_stand"
  },
  "actuator_groups": {
    "legs": {
      "supported": true,
      "actuators": [
        "left_hip_yaw",
        "left_hip_roll",
        "left_hip_pitch",
        "left_knee",
        "left_ankle",
        "right_hip_yaw",
        "right_hip_roll",
        "right_hip_pitch",
        "right_knee",
        "right_ankle"
      ]
    },
    "head_neck": {
      "supported": true,
      "actuators": [
        "neck_pitch",
        "head_pitch",
        "head_yaw",
        "head_roll"
      ]
    },
    "arms_hands": {
      "supported": false,
      "actuators": []
    }
  },
  "implementation_phases": [
    {
      "id": "M7A_skill_manifest",
      "goal": "Declare full skill universe and validate manifest."
    },
    {
      "id": "M7B_skill_listing_validation",
      "goal": "CLI/runtime listing, status filters, and schema validation."
    },
    {
      "id": "M7C_locomotion_wrappers",
      "goal": "Expose existing policy velocity skills through safe wrappers."
    },
    {
      "id": "M7D_head_social",
      "goal": "Implement head/neck social gestures in MuJoCo."
    },
    {
      "id": "M7E_posture_transitions",
      "goal": "Add scripted or teacher-driven sit/stand/crouch/recover."
    },
    {
      "id": "M7F_obstacle_and_terrain",
      "goal": "Trajectory tracking and obstacle-aware clearance via evaluation and residual/RL."
    },
    {
      "id": "M7G_fast_locomotion",
      "goal": "Fast walk/run after speed tracking is proven."
    },
    {
      "id": "M7H_future_hardware_extensions",
      "goal": "Arm/hand gestures only if matching hardware exists."
    }
  ],
  "skills": [
